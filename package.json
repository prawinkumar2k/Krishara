{
  "name": "krishara-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "drizzle-kit push --force",
    "db:seed": "tsx --env-file=.env.local src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test": "tsx --conditions=react-server --env-file=.env.local scripts/verify-reliability.ts && tsx --conditions=react-server --env-file=.env.local scripts/verify-checkout.ts && tsx --conditions=react-server --env-file=.env.local scripts/verify-email.ts && tsx --conditions=react-server --env-file=.env.local scripts/verify-storage.ts",
    "test:e2e": "node --env-file=.env.local scripts/e2e.mjs && node --env-file=.env.local scripts/e2e-features.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.17",
    "lucide-react": "^1.72.0",
    "motion": "^14.12.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
